{
  "name": "motion",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-first PDF-to-Notion expense importer",
  "type": "module",
  "scripts": {
    "predev": "node scripts/verify-pdf-worker.mjs",
    "prebuild": "node scripts/verify-pdf-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "verify:pdf-worker": "node scripts/verify-pdf-worker.mjs"
  },
  "dependencies": {
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "next": "^16.4.5",
    "pdfjs-dist": "4.3.136",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^26.0.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.2"
}
