{
  "name": "motion",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-first PDF-to-Notion expense importer",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
