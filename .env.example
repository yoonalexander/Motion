# Copy this file to .env.local and fill in values locally. Never commit real credentials.
# See README.md for setup guidance.

# Notion OAuth (Phase 3)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/auth/notion/callback
NOTION_API_VERSION=2026-03-11

# Session and token encryption. Generate independent random values, for example:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Optional Gemini category hints (Phase 6). Server-only; never expose to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=

# Public application URL
APP_URL=http://localhost:3000
